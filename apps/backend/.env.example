# App
APP_NAME="Crypto Strategy API"
APP_VERSION="1.0.0"
DEBUG=false

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/cryptostrategy
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/cryptostrategy

# Redis (Railway Redis)
REDIS_URL=redis://localhost:6379

# AI / LLM (custom OpenAI-compatible endpoint)
LLM_BASE_URL=https://9route.sdn188bandungbaru.com/v1
LLM_API_KEY=dummy
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE_GENERATE=0.3
LLM_TEMPERATURE_EXPLAIN=0.5
LLM_TEMPERATURE_CHAT=0.7

# Crypto Exchange
DEFAULT_EXCHANGE=binance

# Firebase FCM (optional — set path to serviceAccountKey.json)
# FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json

# Signal Scanner
SCANNER_INTERVAL_SECONDS=60

# CORS
ALLOWED_ORIGINS=["*"]
